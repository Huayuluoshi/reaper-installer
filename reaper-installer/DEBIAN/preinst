#!/bin/bash
set -e

# preinst 参数: install | upgrade | abort-upgrade | abort-remove
case "$1" in
    install|upgrade) ;;
    *) exit 0 ;;
esac

# 非交互环境跳过预下载；postinst 在非交互时也会跳过，不会因缺缓存失败
if [ -z "$PS1" ] && [ ! -t 0 ]; then
    echo "reaper-installer: 非交互式安装环境，跳过预下载。"
    exit 0
fi

# ---- 架构映射 ----
ARCH="$(dpkg --print-architecture)"
case "$ARCH" in
    amd64)  REAPER_ARCH="x86_64" ;;
    i386)   REAPER_ARCH="i686" ;;
    arm64)  REAPER_ARCH="aarch64" ;;
    armhf)  REAPER_ARCH="armv7l" ;;
    *)
        echo "reaper-installer: 不支持的架构: $ARCH" >&2
        exit 1
        ;;
esac

# ---- 版本与下载地址（构建流程注入版本号）----
REAPER_VERSION="__REAPER_VERSION__"
MAJOR="${REAPER_VERSION%%.*}"
REAPER_TARBALL="reaper${REAPER_VERSION//./}_linux_${REAPER_ARCH}.tar.xz"
DOWNLOAD_URL="https://www.reaper.fm/files/${MAJOR}.x/${REAPER_TARBALL}"

CACHE_DIR="/var/cache/reaper-installer"
CACHE_FILE="$CACHE_DIR/$REAPER_TARBALL"

# 已有完整缓存（同版本重装）直接通过
if [ -s "$CACHE_FILE" ]; then
    echo "reaper-installer: 检测到缓存 ${CACHE_FILE}，跳过预下载。"
    exit 0
fi

# ---- 选择下载器：默认 wget，回退 curl ----
if command -v wget >/dev/null 2>&1; then
    DOWNLOADER="wget"
elif command -v curl >/dev/null 2>&1; then
    DOWNLOADER="curl"
else
    echo "reaper-installer: 系统缺少 wget 和 curl，无法下载安装包。" >&2
    echo "请先安装其中之一： sudo apt install wget" >&2
    exit 1
fi

mkdir -p "$CACHE_DIR"
TMP_FILE="${CACHE_FILE}.part.$$"

# 失败时连同缓存文件、空目录一并清理，保证不残留
cleanup() {
    rm -f "$TMP_FILE" "$CACHE_FILE"
    rmdir "$CACHE_DIR" 2>/dev/null || true
}
trap cleanup EXIT

echo "正在预下载 REAPER Linux 安装包（$DOWNLOADER）..."
echo "URL: $DOWNLOAD_URL"

OK=0
if [ "$DOWNLOADER" = "wget" ]; then
    wget -nv --tries=3 --connect-timeout=15 --read-timeout=60 \
         -O "$TMP_FILE" "$DOWNLOAD_URL" || OK=$?
else
    curl -fL --retry 3 --connect-timeout 15 \
         -o "$TMP_FILE" "$DOWNLOAD_URL" || OK=$?
fi

if [ "$OK" -ne 0 ]; then
    echo "reaper-installer: 下载失败（$DOWNLOADER 退出码 $OK）：$DOWNLOAD_URL" >&2
    echo "请检查网络连接，或确认 REAPER 官方是否已发布该版本/架构。" >&2
    if [ "$DOWNLOADER" = "wget" ]; then
        echo "若报错包含 'certificate ... is not trusted'，请先执行： sudo apt install ca-certificates" >&2
    else
        echo "若报错为 curl (60)，请先执行： sudo apt install ca-certificates" >&2
    fi
    exit 1
fi

mv "$TMP_FILE" "$CACHE_FILE"
trap - EXIT   # 成功：缓存交给 postinst 使用

echo "reaper-installer: 预下载完成。"
exit 0
